  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }

  model User {
    id    String  @id @default(cuid())
    email String  @unique
    name  String?
  }

  model Workflow {
    id        String        @id @default(cuid())
    userId    String
    name      String        @default("Untitled Workflow")
    nodes     Json
    edges     Json
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    runs      WorkflowRun[]
  }

  model WorkflowRun {
    id           String   @id @default(cuid())
    workflowId   String
 workflowName String? 
    type         String   @default("full")
    nodeCount    Int      @default(0)
    status       String   @default("running")
    duration     Int?     // ← add this
    errorMessage String?  // ← add this
    createdAt    DateTime @default(now())

    workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  }